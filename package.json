{
  "name": "@rhizomatics/signalk-delta-squelch-plugin",
  "version": "0.4.3",
  "description": "Clean up noisy SignalK deltas by rounding to sensor's real precision and throttling insignificant or unchanging deltas, reducing compute and storage usage and false anchor alerts.",
  "keywords": [
    "anchor-watch",
    "filter",
    "gps",
    "nmea",
    "noise",
    "signalk",
    "signalk-category-utility",
    "signalk-node-server-plugin"
  ],
  "homepage": "https://github.com/rhizomatics/signalk-delta-squelch-plugin",
  "bugs": {
    "url": "https://github.com/rhizomatics/signalk-delta-squelch-plugin/issues"
  },
  "license": "APACHE-2.0",
  "author": "jey burrows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhizomatics/signalk-delta-squelch-plugin.git"
  },
  "files": [
    "index.js",
    "lib/",
    "docs/",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "index.js",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=\"lib/**/*.js\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 --test"
  },
  "devDependencies": {
    "oxfmt": "^0.61.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "engines": {
    "node": ">=18.0.0",
    "signalk-server": "*"
  },
  "signalk": {
    "displayName": "Delta Squelch",
    "appIcon": "docs/assets/icons/icon.png"
  },
  "signalk-plugin-enabled-by-default": false
}
